# ---------------------------------------------------------------------------
# Plantilla de variables d'entorn — BCN SecureLegal S.L.
# Copieu aquest fitxer a `.env` i substituïu TOTS els valors marcats.
# El fitxer `.env` real NO es versiona mai (vegeu .gitignore).
# ---------------------------------------------------------------------------

# --- Credencials de la base de dades -------------------------------------
# Genereu contrasenyes fortes, per exemple:
#   openssl rand -base64 32
MARIADB_ROOT_PASSWORD=canvia-aquesta-contrasenya-root
MARIADB_DATABASE=bsl_drupal
MARIADB_USER=drupal_user
MARIADB_PASSWORD=canvia-aquesta-contrasenya-aplicacio

# --- Versions d'imatge (reproducibilitat) --------------------------------
# Verificades el 28/10/2026. Actualitzeu-les de manera conscient i documentada.
DRUPAL_IMAGE=drupal:10.6.19-apache
MARIADB_IMAGE=mariadb:10.11.19
